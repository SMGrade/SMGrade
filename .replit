modules = ["nodejs-24"]
run = "PORT=8080 npx pnpm --filter @workspace/api-server run dev & npx pnpm --filter @workspace/smgrade run dev"


[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
